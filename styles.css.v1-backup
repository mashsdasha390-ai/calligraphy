@font-face {
  font-family: "Wremena";
  src: local("Wremena Regular"), local("Wremena"), url("assets/fonts/Wremena-Regular.woff2") format("woff2");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

:root {
  /* Desktop reference: 1440 px. Values scale together with the viewport. */
  --unit: calc(100vw / 1440);
  --gutter: calc(20 * var(--unit));
  --margin: calc(70 * var(--unit));
  --body-size: calc(25 * var(--unit));
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; background: #fff; color: #000; font-family: "Wremena", "Times New Roman", serif; font-size: var(--body-size); font-weight: 400; line-height: 1.28; }
a { color: inherit; text-decoration: none; text-underline-offset: .2em; }
a:hover { text-decoration: underline; }
a:focus-visible { outline: 1px solid currentColor; outline-offset: 6px; }
p, h1, h2 { margin: 0; font: inherit; }
svg { display: block; width: 100%; height: auto; overflow: hidden; }
.container { margin-inline: var(--margin); }
.grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gutter); }
nav a { grid-column: span 3; justify-self: start; }
.header { padding-top: calc(93 * var(--unit)); padding-bottom: calc(20 * var(--unit)); }
.hero { width: 100%; }
.section { padding-top: calc(80 * var(--unit)); scroll-margin-top: calc(40 * var(--unit)); }
.copy { width: calc((100% - 11 * var(--gutter)) / 12 * 6 + 5 * var(--gutter)); }
.copy p + p { margin-top: 1.25em; }
.gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); margin-top: calc(80 * var(--unit)); }
.program { padding-top: calc(80 * var(--unit)); text-align: center; scroll-margin-top: 40px; }
.program-description { max-width: 14em; margin-inline: auto; }
.gallery-small { margin-top: calc(80 * var(--unit)); text-align: left; }
.gallery-small svg { width: 62%; }
.gallery-small svg:nth-child(2) { justify-self: center; }
.gallery-small svg:nth-child(3) { justify-self: end; }
.signup { position: relative; padding-top: calc(110 * var(--unit)); scroll-margin-top: 30px; }
.signup h2 { position: relative; font-size: calc(140 * var(--unit)); line-height: 1.48; text-align: center; letter-spacing: -.045em; }
.signup h2 span { display: block; white-space: nowrap; }
.signup em { color: #e31219; font-style: normal; }
.floating-work { position: absolute; width: 19%; }
.work-one { top: calc(150 * var(--unit)); left: 0; }
.work-two { top: calc(630 * var(--unit)); left: 61%; }
.signup-details { margin-top: calc(240 * var(--unit)); align-items: start; }
.signup-details p { grid-column: 1 / span 6; }
.signup-details svg { grid-column: 8 / span 3; }
.footer { padding-top: calc(900 * var(--unit)); padding-bottom: calc(35 * var(--unit)); }

/* Basic readable fallback; the mobile composition will be designed separately. */
@media (max-width: 700px) {
  :root { --margin: 20px; --gutter: 12px; --body-size: 18px; }
  .header { padding-top: 32px; padding-bottom: 20px; }
  nav { row-gap: 14px !important; }
  nav a { grid-column: span 6; }
  .section, .program { padding-top: 40px; }
  .copy { width: 100%; }
  .gallery { margin-top: 32px; }
  .signup-details { margin-top: 90px; }
  .signup-details p { grid-column: 1 / span 8; }
  .signup-details svg { grid-column: 10 / span 3; }
  .footer { padding-top: 180px; padding-bottom: 24px; }
}
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
