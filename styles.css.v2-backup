@font-face{font-family:Lora;src:url("assets/fonts/Lora-VariableFont_wght.ttf") format("truetype");font-style:normal;font-weight:400 700;font-display:swap}
:root{--u:calc(100vw / 1440);--gap:calc(20 * var(--u));--margin:calc(70 * var(--u));--red:#d2151c;--background:#e2cfcf}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--background);color:#000;font:400 calc(25 * var(--u))/1.3 Lora,Georgia,serif}h1,h2,p,figure{margin:0;font-weight:400}a{color:inherit;text-decoration:none}a:hover{text-decoration:underline}a:focus-visible,button:focus-visible,input:focus-visible{outline:2px solid var(--red);outline-offset:5px}svg{display:block;width:100%;height:auto;overflow:hidden}.container{margin-inline:var(--margin)}.grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--gap);align-items:start}.header{padding-top:calc(36 * var(--u));padding-bottom:calc(13 * var(--u))}nav{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--gap)}nav a{grid-column:span 3}.hero{width:100%}.down{display:block;width:max-content;margin:auto;color:var(--red);font-size:calc(80 * var(--u));line-height:.8}.intro{padding-top:calc(35 * var(--u))}h1,h2{color:var(--red);font-size:calc(145 * var(--u));line-height:1.05;letter-spacing:-.05em}h1{font-size:calc(136 * var(--u))}.small{font-size:calc(21 * var(--u));line-height:1.32}.intro .grid{margin-top:calc(20 * var(--u))}.intro-copy{grid-column:1 / span 5}.intro-art{grid-column:8 / span 5;margin-top:calc(85 * var(--u))}.statement{text-align:center;font-size:calc(43 * var(--u));line-height:1.22;max-width:29em;margin-inline:auto}.intro .statement{margin-block:calc(40 * var(--u))}.process-blue{grid-column:2 / span 6}.process-black{grid-column:8 / span 5;margin-top:calc(210 * var(--u))}.vyaz{margin-top:calc(-340 * var(--u))}.narrow{width:38%;margin-top:calc(20 * var(--u))}.manuscript{margin-top:calc(150 * var(--u))}.history{margin-top:calc(50 * var(--u))}.history-art{grid-column:1 / span 4}.history p{grid-column:5 / span 5}.collage-vyaz{position:relative;height:calc(1790 * var(--u));margin-top:calc(-35 * var(--u))}.collage-vyaz .art{position:absolute}.red-work{width:39%;right:0;top:0}.gold-work{width:39%;left:10%;top:calc(395 * var(--u))}.white-work{width:49%;right:0;top:calc(840 * var(--u))}.circle-work{width:39%;left:0;top:calc(1040 * var(--u))}.green-work{width:49%;right:10%;top:calc(1430 * var(--u))}.poluustav{padding-top:calc(80 * var(--u))}.collage-poluustav{position:relative;height:calc(1300 * var(--u));margin-top:calc(-80 * var(--u))}.collage-poluustav .art{position:absolute}.letters-work{width:49%;left:0;top:calc(140 * var(--u))}.ornament-work{width:39%;right:0;top:0}.practice-work{width:29%;left:10%;top:calc(710 * var(--u))}.blue-work{width:39%;left:40%;top:calc(830 * var(--u))}.program{padding-top:calc(45 * var(--u))}.program-copy{width:42%;margin:calc(170 * var(--u)) 0 calc(160 * var(--u)) 31%;text-align:center}.program-copy p+p{margin-top:1em}.learning{position:relative;padding-bottom:calc(200 * var(--u))}.learning h2{font-size:calc(132 * var(--u));line-height:1.35;text-align:center;color:#000}.learning h2 span{display:block;white-space:nowrap}.learning em{color:var(--red);font-style:normal}.learn-one,.learn-two{position:absolute;width:18%}.learn-one{top:calc(70 * var(--u));left:0}.learn-two{bottom:0;right:20%}.course{margin-top:calc(140 * var(--u))}.course p{grid-column:1 / span 6}.course-art{grid-column:7 / span 6}.signup{padding-top:calc(80 * var(--u))}.signup h2{font-size:calc(48 * var(--u));color:#000;letter-spacing:0}.signup form{width:30%;margin-top:calc(50 * var(--u));display:flex;flex-direction:column;align-items:flex-start}label{font-size:calc(21 * var(--u));margin-bottom:calc(9 * var(--u))}input{width:100%;font:inherit;font-size:calc(20 * var(--u));padding:.5em .65em;border:1px solid #c68f91;background:transparent;color:#000;border-radius:3px;margin-bottom:calc(35 * var(--u))}input::placeholder{color:#715b5b}button{font:inherit;font-size:calc(21 * var(--u));background:var(--red);color:#fff;border:0;border-radius:5px;padding:.6em 1.7em;cursor:pointer}button:hover{background:#af1018}.form-note{font-size:calc(17 * var(--u));margin-top:1em}.footer{display:flex;justify-content:space-between;align-items:flex-end;font-size:calc(18 * var(--u));padding-top:calc(320 * var(--u));padding-bottom:calc(45 * var(--u))}section{scroll-margin-top:30px}
/* Content stays visible if JavaScript or IntersectionObserver is unavailable. */
.reveal.is-pending{opacity:0;transform:translateY(36px);transition:opacity 1.1s ease,transform 1.1s cubic-bezier(.2,.65,.3,1)}.reveal.is-visible{opacity:1;transform:none}
@media(max-width:700px){:root{--margin:20px;--gap:12px}body{font-size:18px}.header{padding-top:24px;padding-bottom:16px}nav{display:flex;justify-content:space-between;gap:12px;font-size:12px}h1{font-size:8.1vw}h2{font-size:14vw}.small{font-size:15px}.intro-copy{grid-column:1 / span 7}.intro-art{grid-column:8 / span 5;margin-top:20px}.statement{font-size:23px}.intro .statement{margin-block:35px}.process-black{margin-top:110px}.vyaz{margin-top:35px}.narrow{width:100%;margin-top:18px}.manuscript{margin-top:32px}.history{margin-top:25px}.history-art{grid-column:1 / span 5}.history p{grid-column:6 / span 7}.collage-vyaz{margin-top:30px}.poluustav{padding-top:40px}.collage-poluustav{margin-top:30px;height:110vw}.letters-work{top:20px}.practice-work{top:55vw}.blue-work{top:64vw}.program-copy{width:85%;margin:55px auto}.learning h2{font-size:8.2vw}.learning{padding-bottom:70px}.learn-one{top:15px}.course{margin-top:45px}.course p{grid-column:1 / span 7}.course-art{grid-column:8 / span 5}.signup{padding-top:45px}.signup h2{font-size:32px}.signup form{width:100%;max-width:360px;margin-top:25px}label,input,button{font-size:16px}.form-note{font-size:13px}.footer{font-size:11px;gap:15px;flex-wrap:wrap;padding-top:90px;padding-bottom:25px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.reveal.is-pending{opacity:1;transform:none;transition:none}}
